rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function validProfile() {
      return request.resource.data.keys().hasOnly(['displayName', 'updatedAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.updatedAt == request.time;
    }
    match /users/{uid} {
      allow read: if owner(uid);
      allow create, update: if owner(uid) && validProfile();
      allow delete: if false;
      match /devices/{deviceId} {
        allow read, delete: if owner(uid);
        allow create, update: if owner(uid)
          && request.resource.data.keys().hasOnly(['token', 'updatedAt'])
          && request.resource.data.token is string
          && request.resource.data.token.size() > 0
          && request.resource.data.token.size() <= 4096
          && request.resource.data.updatedAt == request.time;
      }
      match /notifications/{id} {
        allow read: if owner(uid);
        allow update: if owner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
          && request.resource.data.read is bool;
        allow create, delete: if false;
      }
    }
    match /reports/{reportId} {
      // The prototype community feed is visible to signed-in test accounts.
      // Do not store emails, phone numbers or private profile data here.
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasAll([
          'ownerId', 'category', 'description', 'location', 'barangay',
          'status', 'priority', 'source', 'createdAt', 'updatedAt', 'photoPath', 'coordinates'
        ])
        && request.resource.data.keys().hasOnly([
          'ownerId', 'category', 'description', 'location', 'barangay',
          'status', 'priority', 'source', 'createdAt', 'updatedAt', 'photoPath', 'coordinates'
        ])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.category in ['Road Damage', 'Streetlight', 'Flooding', 'Garbage', 'Water Interruption', 'Other']
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 10
        && request.resource.data.description.size() <= 2000
        && request.resource.data.location is string
        && request.resource.data.location.size() >= 3
        && request.resource.data.location.size() <= 200
        && request.resource.data.barangay is string
        && request.resource.data.barangay.size() >= 2
        && request.resource.data.barangay.size() <= 100
        && request.resource.data.status == 'Pending'
        && request.resource.data.priority == 'Low'
        && request.resource.data.source == 'app'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && (request.resource.data.coordinates == null || request.resource.data.coordinates is latlng)
        && (request.resource.data.photoPath == null ||
          request.resource.data.photoPath == 'report-images/' + request.auth.uid + '/' + reportId + '/photo.jpg');
      // Status/priority mutations go through the official-only callable function.
      allow update, delete: if false;
      match /history/{id} {
        allow read: if signedIn();
        allow write: if false;
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}

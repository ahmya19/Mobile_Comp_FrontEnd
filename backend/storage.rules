rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /report-images/{uid}/{reportId}/photo.jpg {
      function reportExists() {
        return firestore.exists(/databases/(default)/documents/reports/$(reportId));
      }
      allow read: if request.auth != null && reportExists()
        && firestore.get(/databases/(default)/documents/reports/$(reportId)).data.photoPath
          == 'report-images/' + uid + '/' + reportId + '/photo.jpg';
      // Upload before report creation; after publishing, evidence is immutable.
      allow create, update: if request.auth != null && request.auth.uid == uid
        && !reportExists()
        && request.resource.size <= 256000
        && request.resource.contentType == 'image/jpeg';
      allow delete: if request.auth != null && request.auth.uid == uid && !reportExists();
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}

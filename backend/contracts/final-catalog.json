     "select"
    ]
   },
   "constraints": [
    "reports_barangay_check CHECK (((char_length(btrim(barangay)) >= 2) AND (char_length(btrim(barangay)) <= 100)))",
    "reports_category_check CHECK ((category = ANY (ARRAY['Road Damage'::text, 'Streetlight'::text, 'Flooding'::text, 'Garbage'::text, 'Water Interruption'::text, 'Other'::text])))",
    "reports_check CHECK (((latitude IS NULL) = (longitude IS NULL)))",
    "reports_description_check CHECK (((char_length(btrim(description)) >= 10) AND (char_length(btrim(description)) <= 2000)))",
    "reports_latitude_check CHECK (((latitude >= ('-90'::integer)::double precision) AND (latitude <= (90)::double precision)))",
    "reports_latitude_check1 CHECK (((latitude IS NULL) OR ((latitude > '-Infinity'::double precision) AND (latitude < 'Infinity'::double precision))))",
    "reports_location_check CHECK (((char_length(btrim(location)) >= 3) AND (char_length(btrim(location)) <= 200)))",
    "reports_longitude_check CHECK (((longitude >= ('-180'::integer)::double precision) AND (longitude <= (180)::double precision)))",
    "reports_longitude_check1 CHECK (((longitude IS NULL) OR ((longitude > '-Infinity'::double precision) AND (longitude < 'Infinity'::double precision))))",
    "reports_official_priority_check CHECK ((official_priority = ANY (ARRAY['Low'::text, 'Medium'::text, 'High'::text])))",
    "reports_owner_id_fkey FOREIGN KEY (owner_id) REFERENCES auth.users(id) ON DELETE SET NULL",
    "reports_pkey PRIMARY KEY (id)",
    "reports_priority_check CHECK ((priority = ANY (ARRAY['Low'::text, 'Medium'::text, 'High'::text])))",
    "reports_source_check CHECK ((source = ANY (ARRAY['app'::text, 'sms'::text])))",
    "reports_status_check CHECK ((status = ANY (ARRAY['Pending'::text, 'Under Review'::text, 'In Progress'::text, 'Resolved'::text, 'Rejected'::text])))",
    "reports_vote_count_check CHECK ((vote_count >= 0))"
   ]
  }
 ],
